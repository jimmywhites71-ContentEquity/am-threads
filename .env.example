# A NEW Supabase project, not AlphaThreads' (the firewall)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Only if the key covers several workspaces
ANTHROPIC_WORKSPACE_ID=
# A different key from AlphaThreads'
PIPELINE_API_KEY=
# Page a site owner can visit to see who the bot is (shown in the bot's user agent)
BOT_CONTACT_URL=
# Optional model overrides (defaults: claude-haiku-5-5 for summaries, claude-sonnet-5-5 for tagging)
SUMMARY_MODEL=
TAGGER_MODEL=
# Cost controls (defaults 300 pieces a day, $40 a month at list prices)
MAX_PIECES_PER_DAY=300
MONTHLY_BUDGET_USD=40
# Password for the browsing pages (/feed); any user name
VIEW_PASSWORD=
